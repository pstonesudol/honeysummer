SECRET_KEY=change-me-in-production
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honeysummer
# Exact storefront origin for CSRF checks and security links; HTTPS in production.
PUBLIC_ORIGIN=http://localhost:3000
# Persistent Fernet key for MFA and pending security mail; REQUIRED when DEBUG=false.
# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back up separately from the DB. Never regenerate on deploy or commit the key.
SECURITY_ENCRYPTION_KEY=
# Optional comma-separated exact proxy CIDRs. Leave empty until the proxy topology
# is verified to append/replace X-Forwarded-For; never trust 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=

# Email — leave RESEND_API_KEY empty locally to print mail to the console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Honey Summer <hello@hellohoneysummer.com>
INQUIRY_NOTIFICATION_EMAIL=hello@hellohoneysummer.com

# Stripe — test keys for local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_HOLD_MINUTES=45
CHECKOUT_SUCCESS_URL=http://localhost:3000/wholesale?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:3000/wholesale?checkout=cancelled
RETAIL_CHECKOUT_SUCCESS_URL=http://localhost:3000/order-flowers?checkout=success
RETAIL_CHECKOUT_CANCEL_URL=http://localhost:3000/order-flowers?checkout=cancelled
# Delivery charges are configured per listing in /admin/flowers (pickup is free).

# Public catalog/gallery images. Keep both bucket and public CDN URL together.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Customer inquiry photos must be kept in a different, nonpublic bucket.
R2_PRIVATE_BUCKET=
# Optional persistent private disk root for local development only.
# PRIVATE_MEDIA_ROOT=/path/outside/public/media
