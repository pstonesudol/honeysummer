{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/worker.mjs preview",
    "deploy": "node scripts/worker.mjs deploy",
    "upload": "node scripts/worker.mjs upload",
    "build:staging": "node scripts/worker.mjs build staging",
    "build:production": "node scripts/worker.mjs build production",
    "preview:staging": "node scripts/worker.mjs preview staging",
    "preview:production": "node scripts/worker.mjs preview production",
    "deploy:staging": "node scripts/worker.mjs deploy staging",
    "deploy:production": "node scripts/worker.mjs deploy production",
    "upload:staging": "node scripts/worker.mjs upload staging",
    "upload:production": "node scripts/worker.mjs upload production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
